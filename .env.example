# Supabase — proyecto de Arenal Water Sports
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para rutas de servidor (creacion de cuentas, desbloqueos).
# Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Correo saliente para el PIN de recuperacion (US-ACC-006).
# En local se dejan vacias: la aplicacion cae al Inbucket de Supabase
# (127.0.0.1:54325), que no pide credenciales. En produccion hay que
# llenarlas todas: en cuanto SMTP_USER tiene valor, el envio se autentica y
# se cifra.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ve quien recibe el correo.
SMTP_FROM=

# MCP de Stitch (diseno)
STITCH_API_KEY=
